\@writefile{toc}{\contentsline {section}{\numberline {II}Method and Analysis}{1}{}\protected@file@percent }
\newlabel{sec:method}{{II}{1}{}{section.2}{}}
\newlabel{eq:identity}{{1}{1}{}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces IEEE pseudocode formatting example, in a figure rather than a custom algorithm float.}}{1}{}\protected@file@percent }
\newlabel{alg:format}{{1}{1}{}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {III}Experiments or Further Analysis}{1}{}\protected@file@percent }
\newlabel{sec:results}{{III}{1}{}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Figure formatting example; no experimental result is represented.}}{1}{}\protected@file@percent }
\newlabel{fig:single}{{2}{1}{}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {IV}Limitations and Conclusion}{1}{}\protected@file@percent }
\newlabel{pw:main-end}{{IV}{1}{}{section.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Reporting structure only; values have not been supplied.}}{1}{}\protected@file@percent }
\newlabel{tab:conditions}{{I}{1}{}{table.1}{}}
\@writefile{toc}{\contentsline {section}{References}{1}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{Appendix}{1}{}\protected@file@percent }
\newlabel{app:supporting}{{A}{1}{}{section.Appendix.A}{}}
