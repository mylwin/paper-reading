\citation{formatguide}
\bibstyle{named}
\bibdata{references}
\bibcite{formatguide}{\citeauthoryear {{Official author guidelines}}{2026}}
\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{}\protected@file@percent }
\newlabel{sec:introduction}{{1}{1}{}{section.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Method and Analysis}{1}{}\protected@file@percent }
\newlabel{sec:method}{{2}{1}{}{section.2}{}}
\newlabel{eq:identity}{{1}{1}{}{equation.1}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Pseudocode formatting example only}}{1}{}\protected@file@percent }
\newlabel{alg:format}{{1}{1}{}{algorithm.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Experiments or Further Analysis}{1}{}\protected@file@percent }
\newlabel{sec:results}{{3}{1}{}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figure formatting example; no experimental result is represented.}}{1}{}\protected@file@percent }
\newlabel{fig:single}{{1}{1}{}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Reporting structure only; values have not been supplied.}}{1}{}\protected@file@percent }
\newlabel{tab:conditions}{{1}{1}{}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Limitations and Conclusion}{1}{}\protected@file@percent }
\newlabel{pw:main-end}{{4}{1}{}{section.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Wide figure formatting example; replace with author-provided evidence.}}{2}{}\protected@file@percent }
\newlabel{fig:wide}{{2}{2}{}{figure.2}{}}
\gdef \@abspage@last{2}
