\providecommand\hyper@newdestlabel[2]{}
\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\citation{formatguide}
\bibstyle{plainnat}
\bibdata{references}
\bibcite{formatguide}{{1}{2026}{{Official author guidelines}}{{}}}
\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\newlabel{sec:introduction}{{1}{1}{Introduction}{section.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Method and Analysis}{1}{section.2}\protected@file@percent }
\newlabel{sec:method}{{2}{1}{Method and Analysis}{section.2}{}}
\newlabel{eq:identity}{{1}{1}{Method and Analysis}{equation.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Experiments or Further Analysis}{1}{section.3}\protected@file@percent }
\newlabel{sec:results}{{3}{1}{Experiments or Further Analysis}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figure formatting example; no experimental result is represented.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:single}{{1}{1}{Figure formatting example; no experimental result is represented}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Limitations and Conclusion}{1}{section.4}\protected@file@percent }
\newlabel{pw:main-end}{{4}{1}{Limitations and Conclusion}{section.4}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Pseudocode formatting example only}}{2}{algorithm.1}\protected@file@percent }
\newlabel{alg:format}{{1}{2}{Method and Analysis}{algorithm.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Wide figure formatting example; replace with author-provided evidence.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:wide}{{2}{2}{Wide figure formatting example; replace with author-provided evidence}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Reporting structure only; values have not been supplied.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:conditions}{{1}{2}{Reporting structure only; values have not been supplied}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A}Supporting Details}{3}{appendix.A}\protected@file@percent }
\newlabel{app:supporting}{{A}{3}{Supporting Details}{appendix.A}{}}
\gdef \@abspage@last{9}
