\bibstyle{plainnat}
\citation{formatguide}
\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\newlabel{sec:introduction}{{1}{1}{}{section.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Method and Analysis}{1}{section.2}\protected@file@percent }
\newlabel{sec:method}{{2}{1}{}{section.2}{}}
\newlabel{eq:identity}{{1}{1}{}{equation.1}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Pseudocode formatting example only}}{1}{algorithm.1}\protected@file@percent }
\newlabel{alg:format}{{1}{1}{}{algorithm.1}{}}
\bibdata{references}
\bibcite{formatguide}{{1}{2026}{{Official author guidelines}}{{}}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Experiments or Further Analysis}{2}{section.3}\protected@file@percent }
\newlabel{sec:results}{{3}{2}{}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figure formatting example; no experimental result is represented.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:single}{{1}{2}{Figure formatting example; no experimental result is represented}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Reporting structure only; values have not been supplied.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:conditions}{{1}{2}{Reporting structure only; values have not been supplied}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Limitations and Conclusion}{2}{section.4}\protected@file@percent }
\newlabel{pw:main-end}{{4}{2}{}{section.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A}Supporting Details}{2}{appendix.A}\protected@file@percent }
\newlabel{app:supporting}{{A}{2}{}{appendix.A}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Wide figure formatting example; replace with author-provided evidence.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:wide}{{2}{3}{Wide figure formatting example; replace with author-provided evidence}{figure.2}{}}
\gdef \@abspage@last{3}
